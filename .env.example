# Base de datos PostgreSQL (Neon - https://neon.tech)
# Usa la connection string "pooled" de Neon para DATABASE_URL
DATABASE_URL="postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/nutriplan?sslmode=require&pgbouncer=true"
# Usa la connection string "direct" de Neon para DIRECT_URL (migraciones)
DIRECT_URL="postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/nutriplan?sslmode=require"

# NextAuth - Autenticacion
# Genera un secret con: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp Business API (opcional)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ID=""
WHATSAPP_VERIFY_TOKEN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="NutriPlan Pro"
